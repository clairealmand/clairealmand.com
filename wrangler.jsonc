// Cloudflare settings: serve this folder as a static site, no build step.
{
  "name": "clairealmand-com",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "clairealmand.com", "custom_domain": true },
    { "pattern": "www.clairealmand.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  }
}
